# GitHub personal access tokens (at least one required).
# Create at https://github.com/settings/tokens/new with `repo` and `user` scopes.
PAT_1=

# Optional: override cache TTL (seconds) for all cards.
# CACHE_SECONDS=

# Optional: make this a private instance (only these users + valid token get cards).
# GRS_TOKEN=
# ALLOWED_USERNAMES=wthrajat

# Optional: fetch stars across all repo pages (public instances leave unset).
# FETCH_MULTI_PAGE_STARS=true

# Server port (default 9000).
PORT=9000
